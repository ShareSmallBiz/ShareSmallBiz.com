{
  "openapi": "3.1.1",
  "info": {
    "title": "ShareSmallBiz API",
    "description": "The ShareSmallBiz API: accounts and member profiles for the ShareSmallBiz small-business community.\n\n## Getting started\n1. **Register**: `POST /api/v1/auth/register`. The response is always `202` and a confirmation email is sent.\n2. **Confirm your email**: the email links to the client's `/confirm-email?userId=…&token=…` page.\n   Send those two values to `POST /api/v1/auth/confirm-email`.\n   *Running locally?* Read the email with `GET /dev/mailbox/latest?to=<your email>`, which is available in Development only.\n3. **Sign in**: `POST /api/v1/auth/login` returns an `accessToken` (15 minutes) and a `refreshToken` (14 days).\n   Send `Authorization: Bearer <accessToken>` on secured calls; they are marked with a lock.\n4. **Stay signed in**: exchange the refresh token at `POST /api/v1/auth/refresh`. Each refresh token works **once**;\n   replaying a spent one ends the whole session.\n5. **Your profile**: `GET /api/v1/me`, then `PUT /api/v1/me/profile`. Others see it at `GET /api/v1/profiles/{userName}`.\n\n## Conventions\n- **Errors** are [RFC 9457 problem details](https://www.rfc-editor.org/rfc/rfc9457) (`application/problem+json`).\n  Validation failures carry an `errors` object keyed by field.\n- **Lists** return `{ items, page, pageSize, totalCount, totalPages }`. `page` starts at 1, and `pageSize` is at most 50.\n- **Enums** are strings, e.g. `\"Public\"`.\n- **Privacy:** only `GET /api/v1/me` returns your email and other private fields. No other response does.\n- **Rate limits:** auth endpoints allow 10 requests per minute per IP and return `429` beyond that.",
    "version": "v1"
  },
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "Account: Authentication"
        ],
        "summary": "Create an account",
        "description": "Creates the account and emails a confirmation link. Sign-in is blocked until the email is confirmed.\n\nAlways returns **202** for a well-formed request, even when the email already has an account\n(that owner is emailed instead), so this endpoint cannot be used to discover who is a member.\nReturns **400** when the username is taken or a field is invalid.",
        "operationId": "Register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "202": {
            "description": "Accepted"
          }
        }
      }
    },
    "/api/v1/auth/confirm-email": {
      "post": {
        "tags": [
          "Account: Authentication"
        ],
        "summary": "Confirm an email address",
        "description": "Send the `userId` and `token` from the confirmation link. **204** when confirmed (or already confirmed); **400** when the link is invalid or expired.",
        "operationId": "ConfirmEmail",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmEmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/v1/auth/resend-confirmation": {
      "post": {
        "tags": [
          "Account: Authentication"
        ],
        "summary": "Resend the confirmation email",
        "description": "Sends a new confirmation link if the account exists and is unconfirmed. Always **202**.",
        "operationId": "ResendConfirmation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "202": {
            "description": "Accepted"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Account: Authentication"
        ],
        "summary": "Sign in",
        "description": "Exchanges email and password for tokens. Send `accessToken` as `Authorization: Bearer <accessToken>`;\nkeep `refreshToken` for `POST /api/v1/auth/refresh`.\n\n- **401**: wrong email or password, or the account is locked (5 failures lock it for 15 minutes). The response is identical in every case.\n- **403** with `code: email_not_confirmed`: the email is not confirmed yet.",
        "operationId": "Login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokensResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": [
          "Account: Authentication"
        ],
        "summary": "Refresh the tokens",
        "description": "Exchanges a refresh token for a new access token **and** a new refresh token. Each refresh token works once:\npresenting one that was already used is treated as theft and ends that whole session (**401**).",
        "operationId": "RefreshTokens",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokensResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "Account: Authentication"
        ],
        "summary": "Sign out of this session",
        "description": "Revokes the session the refresh token belongs to; other sessions stay signed in. Always **204**.",
        "operationId": "Logout",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/v1/auth/forgot-password": {
      "post": {
        "tags": [
          "Account: Authentication"
        ],
        "summary": "Request a password reset email",
        "description": "Emails a reset link if a confirmed account exists. Always **202**, so it reveals nothing about who is a member.",
        "operationId": "ForgotPassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "202": {
            "description": "Accepted"
          }
        }
      }
    },
    "/api/v1/auth/reset-password": {
      "post": {
        "tags": [
          "Account: Authentication"
        ],
        "summary": "Set a new password",
        "description": "Send the `email` and `token` from the reset link with the new password. On success (**204**) every session is signed out.",
        "operationId": "ResetPassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/v1/profiles": {
      "get": {
        "tags": [
          "Members: Profiles"
        ],
        "summary": "Member directory",
        "description": "Public members, newest first. Only confirmed members with `Public` visibility are listed.\n\n`search` matches display name or username (case-insensitive, contains). `%` and `_` are matched literally.",
        "operationId": "ListProfiles",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "maximum": 2147483647,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "maximum": 50,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 20
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "maxLength": 100,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResponseOfPublicProfileResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/profiles/{userName}": {
      "get": {
        "tags": [
          "Members: Profiles"
        ],
        "summary": "A member's public profile",
        "description": "Looks up by username, case-insensitive. Returns **404** when the member does not exist, has not confirmed\ntheir email, or set their profile to `Private`; it never reveals which. Members always see their own profile.",
        "operationId": "GetProfile",
        "parameters": [
          {
            "name": "userName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProfileResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "Account: Me"
        ],
        "summary": "Your account",
        "description": "Your own account, including private fields (email, real name, visibility). The only endpoint that returns them.",
        "operationId": "GetCurrentUser",
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/v1/me/profile": {
      "put": {
        "tags": [
          "Account: Me"
        ],
        "summary": "Update your profile",
        "description": "Replaces every editable field: omitted optional fields are cleared. Returns your updated account.",
        "operationId": "UpdateMyProfile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AuthTokensResponse": {
        "required": [
          "tokenType",
          "accessToken",
          "accessTokenExpiresAt",
          "refreshToken",
          "refreshTokenExpiresAt"
        ],
        "type": "object",
        "properties": {
          "tokenType": {
            "type": "string",
            "description": "Always `Bearer`."
          },
          "accessToken": {
            "type": "string",
            "description": "Send as `Authorization: Bearer <accessToken>`."
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshToken": {
            "type": "string",
            "description": "Exchange at `POST /api/v1/auth/refresh` before it expires. Single use."
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "Issued by login and refresh."
      },
      "ConfirmEmailRequest": {
        "required": [
          "userId",
          "token"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "examples": [
              "paste userId from the confirmation link"
            ],
            "type": "string",
            "description": "The `userId` query value from the confirmation link."
          },
          "token": {
            "examples": [
              "paste token from the confirmation link"
            ],
            "type": "string",
            "description": "The `token` query value from the confirmation link, as-is."
          }
        },
        "description": "Values from the confirmation link (`/confirm-email?userId=…&token=…`)."
      },
      "CurrentUserResponse": {
        "required": [
          "id",
          "email",
          "emailConfirmed",
          "userName",
          "displayName",
          "firstName",
          "lastName",
          "bio",
          "websiteUrl",
          "profileVisibility",
          "joinedAt",
          "roles"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "emailConfirmed": {
            "type": "boolean"
          },
          "userName": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "firstName": {
            "type": [
              "null",
              "string"
            ]
          },
          "lastName": {
            "type": [
              "null",
              "string"
            ]
          },
          "bio": {
            "type": [
              "null",
              "string"
            ]
          },
          "websiteUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "profileVisibility": {
            "$ref": "#/components/schemas/ProfileVisibility"
          },
          "joinedAt": {
            "type": "string",
            "format": "date-time"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "description": "Your own account, including private fields. Only ever returned to you."
      },
      "EmailRequest": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "examples": [
              "owner@corner-bakery.example"
            ],
            "maxLength": 256,
            "type": "string"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "examples": [
              "owner@corner-bakery.example"
            ],
            "type": "string"
          },
          "password": {
            "examples": [
              "correct horse battery"
            ],
            "type": "string"
          }
        }
      },
      "PagedResponseOfPublicProfileResponse": {
        "required": [
          "items",
          "page",
          "pageSize",
          "totalCount",
          "totalPages"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicProfileResponse"
            }
          },
          "page": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pageSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "totalCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "totalPages": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProfileVisibility": {
        "enum": [
          "Public",
          "Private"
        ]
      },
      "PublicProfileResponse": {
        "required": [
          "userName",
          "displayName",
          "bio",
          "websiteUrl",
          "joinedAt"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "type": "string",
            "description": "Profile slug, as used in `/api/v1/profiles/{userName}`."
          },
          "displayName": {
            "type": "string"
          },
          "bio": {
            "type": [
              "null",
              "string"
            ],
            "description": "Plain text; render as text, never as HTML."
          },
          "websiteUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "joinedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "What anyone may see about a member. Never carries email, real names or account state."
      },
      "RefreshRequest": {
        "required": [
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "refreshToken": {
            "examples": [
              "paste refreshToken from login"
            ],
            "type": "string",
            "description": "The `refreshToken` from login or the previous refresh. Works once."
          }
        }
      },
      "RegisterRequest": {
        "required": [
          "email",
          "password",
